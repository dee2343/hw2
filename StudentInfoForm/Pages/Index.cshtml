@page
@model IndexModel
@{
    ViewData["Title"] = "Student Registration Form";
}


 
<div class="container mt-5" style="max-width: 500px;">
    <h1>Student Registration Form</h1>
    
    <form method="post" class="mt-4">
        <!-- Darnell flowers -->
        <div class="mb-3">
            <label for="studentName" class="form-label">Student Name:</label>
            <input 
                type="text" 
                class="form-control" 
                id="studentName" 
                name="StudentName"
                placeholder="Darnell flowers"
                 
            />
        </div>
  
  <!-- Email Field -->
        <div class="mb-3">
            <label for="email" class="form-label">Email Address:</label>
            <input 
                type="email" 
                class="form-control" 
                id="email" 
                name="Email"
                placeholder="dflowe10@smartweb.augustatech.edu"
            />
        </div>
  <!-- Major Dropdown -->
        <div class="mb-3">
            <label for="major" class="form-label">Major:</label>
            <select class="form-select" id="major" name="Major" required>
                <option value="">-- Select a Major --</option>
                <option value="Computer Science">Computer Science</option>
                <option value="Engineering">Engineering</option>
                <option value="Business">Business</option>
                <option value="Biology">Biology</option>
            </select>
        </div>
         <!-- Checkbox -->
        <div class="mb-3 form-check">
            <input 
                type="checkbox" 
                class="form-check-input" 
                id="agreeTerms" 
                name="Darnell flowers"
                required 
            />
            <label class="form-check-label" for="agreeTerms">
                I agree to the terms and conditions
            </label>
        </div>
 
        <!-- Submit Button -->
        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary" id="submitBtn">
                Register
            </button>
        </div>
    </form>
 
    <!-- Success Message (shown after form submission) -->
    @if (ViewData["goodjob"] != null)
    {
        <div class="alert alert-success mt-4" role="alert">
            <strong>Success!</strong> Registration submitted for: @ViewData["StudentName"]
        </div>
    }
</div>